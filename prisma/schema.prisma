  guide_cn         String?
  // 사용여부 — Y=사용중(AI가 이 가이드를 참조) / N=미사용(보관만, AI에 전달 안 함)
  // 삭제는 물리 삭제로 별도 처리 — use_yn은 "사용중/미사용" 비즈니스 속성 전용
  use_yn           String    @default("Y") @db.Char(1)
  creat_mber_id    String
  creat_dt         DateTime  @default(now())
  mdfr_mber_id     String?
  mdfcn_dt         DateTime?

  // 프로젝트 삭제 시 자동 정리 (2026-05-06 P2 보강)
  project TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_sg_std_guide_prjct_fk")

  @@index([prjct_id, use_yn, mdfcn_dt(sort: Desc), creat_dt(sort: Desc)], map: "tb_sg_std_guide_prjct_dt_idx")
  @@index([prjct_id, guide_ctgry_code, use_yn], map: "tb_sg_std_guide_ctgry_idx")
  @@map("tb_sg_std_guide")
}

// ── Docs Hub: 시스템 문서 섹션 (1단계 트리) ───────────────────────────────
// 도움창고 > DOCS 의 좌측 트리 1단계. SUPER_ADMIN 만 작성·편집.
// prjct_id 없음 — 시스템 자산. 트리 깊이 2단계 고정 (section > page).
//
// sect_slug 의 활성(use_yn='Y') 유니크는 partial unique index 로 처리되어
// 비활성으로 보존된 동일 슬러그가 충돌을 일으키지 않는다.
model TbSysDocsSection {
  sect_id        String    @id @default(uuid())
  sect_slug      String // partial unique: where use_yn='Y'
  sect_nm        String    @default("")
  sect_icon_code String?
  sort_ordr      Int       @default(0)
  use_yn         String    @default("Y") @db.Char(1)
  creat_mber_id  String?
  creat_dt       DateTime  @default(now())
  mdfr_mber_id   String?
  mdfcn_dt       DateTime?

  pages TbSysDocsPage[]

  @@index([use_yn, sort_ordr], map: "tb_sys_docs_section_use_idx")
  @@map("tb_sys_docs_section")
}

// ── Docs Hub: 시스템 문서 페이지 (2단계 — 실제 문서 본문) ─────────────────
// 본문은 Markdown(page_cn). 라우팅: /docs/[sect_slug]/[page_slug].
//   page_sttus_code: DRAFT | PUBLISHED | ARCHIVED
//   badge_code     : NEW | BETA | DEPRECATED | NULL
//
// 사용자 뷰어에는 page_sttus_code='PUBLISHED' AND use_yn='Y' 만 노출.
// (sect_id, page_slug) 조합은 use_yn='Y' 범위에서 유니크 (partial unique).
model TbSysDocsPage {
  page_id         String    @id @default(uuid())
  sect_id         String
  page_slug       String
  page_sj         String    @default("")
  page_excerpt    String?
  page_cn         String?
  page_sttus_code String    @default("DRAFT")
  badge_code      String?
  sort_ordr       Int       @default(0)
  use_yn          String    @default("Y") @db.Char(1)
  creat_mber_id   String?
  creat_dt        DateTime  @default(now())
  mdfr_mber_id    String?
  mdfcn_dt        DateTime?

  // 페이지가 매달린 섹션은 물리 삭제 금지 — 운영 워크플로우는 use_yn='N' 으로 숨김
  section TbSysDocsSection @relation(fields: [sect_id], references: [sect_id], onDelete: Restrict, onUpdate: Cascade, map: "tb_sys_docs_page_sect_fk")

  @@index([sect_id, use_yn, sort_ordr], map: "tb_sys_docs_page_sect_idx")
  @@index([page_sttus_code, mdfcn_dt(sort: Desc), creat_dt(sort: Desc)], map: "tb_sys_docs_page_sttus_idx")
  @@map("tb_sys_docs_page")
}

// ── 시스템 첨부파일 (SUPER_ADMIN 업로드) ──────────────────────────────────
// tb_cm_attach_file(프로젝트 멤버 업로드)와 별도 분리.
// - lifecycle: 시스템 lifetime 전체 (프로젝트 cascade 영향 없음)
// - 권한    : SUPER_ADMIN 전용
// - 정책    : 별도 용량/확장자 화이트리스트
//
// 다형 참조:
//   ref_tbl_nm = 'tb_sys_docs_page'  → Docs 본문/별첨
//   ref_tbl_nm = 'tb_sys_resource'   → 자료실(추후)
//
// 첨부 구분:
//   attach_div_code = 'INLINE' (Markdown 본문 삽입 이미지)
//   attach_div_code = 'ATTACH' (페이지 하단 별첨 다운로드)
model TbSysAttachFile {
  attach_id       String    @id @default(uuid())
  ref_tbl_nm      String
  ref_id          String
  attach_div_code String    @default("ATTACH")
  orgnl_file_nm   String
  stor_file_nm    String
  file_path_nm    String
  file_sz         BigInt
  file_extsn_nm   String
  mime_ty         String    @default("")
  sort_ordr       Int       @default(0)
  use_yn          String    @default("Y") @db.Char(1)
  creat_mber_id   String?
  creat_dt        DateTime  @default(now())
  mdfr_mber_id    String?
  mdfcn_dt        DateTime?

  @@index([ref_tbl_nm, ref_id, use_yn, sort_ordr], map: "tb_sys_attach_file_ref_idx")
  @@index([use_yn, creat_dt(sort: Desc)], map: "tb_sys_attach_file_use_idx")
  @@map("tb_sys_attach_file")
}

// ── MCP 키 — Claude Code 등 외부 AI 클라이언트의 인바운드 인증용 ─────────
// prjct_id = 'ALL'  → 전역 키 (해당 사용자가 ACTIVE 멤버인 모든 프로젝트 접근 가능)
// prjct_id = UUID   → 프로젝트 단위 scope 고정 (다른 프로젝트 접근 시 403 FORBIDDEN_SCOPE)
//
// fail-secure 설계:
//   - NOT NULL (@default 없음) → INSERT 시 반드시 명시 지정 (누락 시 DB 오류)
//   - 'ALL' 명시적 sentinel → null 의존이 없어져 "실수로 전역 권한" 사고 차단
//   - tb_pj_project FK 없음 → 'ALL'이 실제 프로젝트가 아니라 FK 불가. 대신 프로젝트
//     삭제 시 scope 키는 멤버십 조회에서 403 되므로 무해화됨(app 레이어 보호).
//
// 원문은 저장하지 않고 SHA-256 해시만 저장 (spk_ prefix + 32B 랜덤 hex).
// NOTE: tb_pj_project_api_key(외부 AI provider 키 보관소)와 혼동 금지 — 용도/저장방식 다름.
model TbCmMcpKey {
  api_key_id String @id @default(uuid())
  mber_id    String
  prjct_id   String // 'ALL' 또는 UUID — NOT NULL, no default

  // [2026-04-26] 키 용도 구분 — Claude Code MCP / 워커 인증 채널 분리
  //   CLIENT — Claude Code MCP 도구용 (전역/프로젝트 scope 모두 허용)
  //   WORKER — /run-ai-tasks 워커용 (프로젝트 scope 강제, 전역 발급 거부)
  // CHECK 제약(prisma/sql/2026-04-26_add_mcp_key_use_se_code.sql)으로
  // 두 값 외에는 INSERT 자체 차단된다.
  key_use_se_code String @default("CLIENT") @db.VarChar(20)

  key_hash     String    @unique
  key_prefix   String    @db.VarChar(12)
  key_nm       String    @db.VarChar(100)
  last_used_dt DateTime?
  revoke_dt    DateTime?
  creat_dt     DateTime  @default(now())

  member TbCmMember @relation(fields: [mber_id], references: [mber_id])

  @@index([mber_id], map: "idx_mcp_key_mber")
  @@index([prjct_id], map: "idx_mcp_key_prjct")
  @@index([mber_id, key_use_se_code, revoke_dt], map: "idx_mcp_key_use_se")
  @@map("tb_cm_mcp_key")
}

// Rate Limit 카운터 — 인증 엔드포인트(로그인/가입/재설정/토큰갱신) 남용 방어용.
// Fixed Window Counter: src/lib/rateLimit.ts 의 checkRateLimit 헬퍼에서 upsert.
// 키 포맷: "<ENDPOINT>_<DIMENSION>:<value>" (예: LOGIN_IP:1.2.3.4)
model TbCmRateLimit {
  rate_key_val    String   @id @db.VarChar(200)
  window_start_dt DateTime
  req_cnt         Int      @default(0)
  creat_dt        DateTime @default(now())
  updt_dt         DateTime @default(now())

  @@index([window_start_dt], map: "tb_cm_rate_limit_window_idx")
  @@map("tb_cm_rate_limit")
}

// ── 구현요청 스냅샷 — 각 계층의 _dc 내용을 요청 시점에 저장 (diff 추적용) ──
model TbSpImplSnapshot {
