  rpt_yn        String      @default("Y") @db.Char(1)
  sort_ordr     Int         @default(0)
  creat_mber_id String
  creat_dt      DateTime    @default(now())
  mdfr_mber_id  String?
  mdfcn_dt      DateTime?
  project       TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_wr_issue_prjct_fk")

  // 주차 스냅샷이 아니라 프로젝트가 계속 관리하는 살아있는 목록 — 정렬 순서 인덱스만 필요
  @@index([prjct_id, sort_ordr], map: "idx_wr_issue_prjct_sort")
  @@map("tb_wr_issue")
}

