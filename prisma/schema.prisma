/// AI 프롬프트 템플릿 — tb_ai_prompt_template
///
/// 매칭 차원:
///   - ref_ty_code  : 어떤 entity (UNIT_WORK/SCREEN/AREA/FUNCTION/PLAN_STUDIO_ARTF)
///   - task_ty_code : 무엇을 할지 (DESIGN/INSPECT/IMPACT/IMPLEMENT/CUSTOM/PLAN_STUDIO_ARTF_GENERATE)
///   - div_code     : 산출물 구분 (PLAN_STUDIO_ARTF 전용; IA/JOURNEY/FLOW/MOCKUP/ERD/PROCESS, 그 외 NULL)
///   - fmt_code     : 출력 형식  (PLAN_STUDIO_ARTF 전용; MD/MERMAID/HTML, 그 외 NULL)
///
/// 일반 사용처는 (ref_ty_code, task_ty_code) 만으로 매칭, div/fmt 는 NULL.
/// 기획실 산출물은 (ref_ty_code='PLAN_STUDIO_ARTF', task_ty_code='PLAN_STUDIO_ARTF_GENERATE', div_code, fmt_code) 4컬럼 매칭.
model TbAiPromptTemplate {
  tmpl_id       String   @id(map: "pk_ai_prompt_template") @db.VarChar(36)
  prjct_id      String?  @db.VarChar(36)
  tmpl_nm       String   @db.VarChar(200)
  // VARCHAR(30): 'PLAN_STUDIO_ARTF_GENERATE' (25자) 등 긴 코드 수용
  task_ty_code  String   @db.VarChar(30)
  ref_ty_code   String?  @db.VarChar(20)
  div_code      String?  @db.VarChar(20)
  fmt_code      String?  @db.VarChar(20)
  sys_prompt_cn String?
  tmpl_dc       String?
  use_yn        String   @default("Y") @db.Char(1)
  sort_ordr     Int      @default(0)
  creat_mber_id String?  @db.VarChar(36)
  creat_dt      DateTime @default(now()) @db.Timestamp(6)
  mdfcn_dt      DateTime @default(now()) @db.Timestamp(6)
  use_cnt       Int      @default(0)
  default_yn    String   @default("N") @db.Char(1)

  @@index([prjct_id, task_ty_code, use_yn], map: "idx_ai_tmpl_prjct")
  @@index([ref_ty_code, task_ty_code, div_code, fmt_code], map: "idx_ai_tmpl_plan_studio")
  @@map("tb_ai_prompt_template")
}

/// 설계 양식 (예시+템플릿 마크다운) — tb_ai_design_template
/// 5계층 상세 페이지의 "예시"/"템플릿 삽입" 버튼 소스를 DB로 관리.
/// prjct_id = NULL 이면 시스템 공통, UUID 면 해당 프로젝트 전용.
/// 프로젝트 전용이 공통을 override (resolve 우선순위에서 prjct_id NOT NULL 우선).
model TbAiDesignTemplate {
  dsgn_tmpl_id  String   @id(map: "pk_ai_design_template") @db.VarChar(36)
  prjct_id      String?  @db.VarChar(36)
  ref_ty_code   String   @db.VarChar(20) // REQUIREMENT | UNIT_WORK | SCREEN | AREA | FUNCTION
  tmpl_nm       String   @db.VarChar(200)
  tmpl_dc       String?
  example_cn    String?
  template_cn   String?
  use_yn        String   @default("Y") @db.Char(1)
  default_yn    String   @default("N") @db.Char(1)
  sort_ordr     Int      @default(0)
  creat_mber_id String?  @db.VarChar(36)
  creat_dt      DateTime @default(now()) @db.Timestamp(6)
  mdfcn_dt      DateTime @default(now()) @db.Timestamp(6)

  @@index([ref_ty_code, use_yn, prjct_id, default_yn, sort_ordr], map: "idx_ai_dsgn_tmpl_scope")
  @@index([prjct_id, ref_ty_code, sort_ordr], map: "idx_ai_dsgn_tmpl_prjct")
  @@map("tb_ai_design_template")
}

// ── 업무일지 / 주간보고 (2026-07-20 도입) ──────────────────────────────────
// 목적 1: 팀원의 일일/주간 업무일지를 모아 PM 주간보고 초안을 AI 로 생성
// 목적 2: 개발자가 하루 시작 전 오늘 할 일을 계획하고, 마무리에 한 일을 기록하는 습관 형성
model TbWrWorkLog {
  work_log_id   String            @id @default(uuid())
  prjct_id      String
  creat_mber_id String // 작성자 — FK 미설정(퇴장 멤버 기록 보존)
  // DAILY = log_dt 당일 일지, WEEK = log_dt(그 주 월요일) 기준 "이번주 계획"
  log_ty_code   String            @default("DAILY") @db.VarChar(10)
  log_dt        DateTime          @db.Date
  // DAILY: 오늘 작업 결과(특이사항), WEEK: 이번주 계획 개요
  note_cn       String?
  // WEEK 전용 — "이번주 결과"(주간 회고). DAILY는 결과를 note_cn 하나로 충분히 표현하지만
  // WEEK는 계획(note_cn)과 결과를 별도 텍스트로 구분해 달라는 요청으로 추가 (2026-07-20).
  // DAILY 로그에서는 사용하지 않음(항상 null).
  result_cn     String?
  creat_dt      DateTime          @default(now())
  mdfr_mber_id  String?
  mdfcn_dt      DateTime?
  items         TbWrWorkLogItem[]
  project       TbPjProject       @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_wr_work_log_prjct_fk")

  // 회원 1명당 하루/한 주에 로그 1건만 존재 — upsert 키
  @@unique([prjct_id, creat_mber_id, log_ty_code, log_dt], map: "uk_wr_work_log_mber_day")
  // 팀 전체 조회(주간보고 집계) / 날짜 범위 조회 공통 인덱스
  @@index([prjct_id, log_ty_code, log_dt], map: "idx_wr_work_log_prjct_dt")
  @@map("tb_wr_work_log")
}

model TbWrWorkLogItem {
  item_id     String      @id @default(uuid())
  work_log_id String
  item_cn     String // 할일 내용 — 자유 텍스트 또는 연결된 일감명 스냅샷
  // 일감 연결 시: UNIT_WORK | SCREEN | FUNCTION | TASK — 미연결이면 둘 다 null
  ref_ty_code String?     @db.VarChar(20)
  ref_id      String? // FK 미설정 — ref_ty_code 로 분기 조회 (TbAiTask.ref_* 와 동일 관례)
  done_yn     String      @default("N") @db.Char(1)
  sort_ordr   Int         @default(0)
  creat_dt    DateTime    @default(now())
  workLog     TbWrWorkLog @relation(fields: [work_log_id], references: [work_log_id], onDelete: Cascade, map: "tb_wr_work_log_item_log_fk")

  @@index([work_log_id], map: "idx_wr_work_log_item_log")
  @@map("tb_wr_work_log_item")
}

model TbWrWeeklyReport {
  weekly_report_id String      @id @default(uuid())
  prjct_id         String
  week_start_dt    DateTime    @db.Date // 그 주 월요일
  // AI가 생성한 원본 그대로 — 참고용이며 더 이상 편집 대상이 아님(읽기 전용 표시 + 복사).
  // "## 금주실적" 헤더에 오타가 나면 구분이 안 되는 문제가 있어(2026-07-22), 실제 보고서로
  // 쓰는 내용은 아래 perf_cn/plan_cn/comment_cn/note_cn 컬럼으로 분리했다 — PM이 이 원본을
  // 참고해서 직접 채워 넣는다(자동 파싱 없음).
  draft_cn         String?
  // 금주실적 — PM이 직접 작성/편집. AI 원본과 구분되는, 실제 보고서에 나가는 내용.
  perf_cn          String?
  // 차주계획 — PM이 직접 작성/편집.
  plan_cn          String?
  // 금주 코멘트 — "실적/계획 자세히 볼 시간 없으면 이것만 보세요" 식의 짧은 요약(선택).
  // "총평"이라는 이름이 자기평가처럼 느껴진다는 피드백으로 이름을 바꿨다(2026-07-22,
  // 이전 컬럼명 review_cn).
  comment_cn       String?
  // 특이사항 — 평가가 아니라 이번 주에 있었던 특기할 사항을 짧게 남기는 자리(선택).
  note_cn          String?
