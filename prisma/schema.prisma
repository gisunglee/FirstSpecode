generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TbCmMember {
  mber_id             String                     @id @default(uuid())
  email_addr          String?                    @unique
  pswd_hash           String?
  mber_nm             String?
  profl_img_url       String?
  mber_sttus_code     String                     @default("UNVERIFIED")
  plan_code           String                     @default("FREE") // 계정 플랜 (FREE/PRO/TEAM/ENTERPRISE)
  plan_expire_dt      DateTime? // 유료 플랜 만료일 (NULL=무료/무제한)
  asignee_view_mode   String                     @default("all") // 전역 담당자 필터 모드: all | me
  /// 시스템 역할: "SUPER_ADMIN" = 전역 관리자 / null = 일반 사용자.
  /// DB UPDATE로만 설정. UI/API 로는 변경 불가 (탈취 시 권한 연쇄 상승 차단).
  sys_role_code       String?                    @db.VarChar(20)
  join_dt             DateTime                   @default(now())
  mdfcn_dt            DateTime?
  wthdrw_dt           DateTime?
  accountLocks        TbCmAccountLock[]
  emailVerifications  TbCmEmailVerification[]
  loginAttempts       TbCmLoginAttempt[]
  memberSessions      TbCmMemberSession[]
  passwordResetTokens TbCmPasswordResetToken[]
  refreshTokens       TbCmRefreshToken[]
  socialAccounts      TbCmSocialAccount[]
  mcpKeys             TbCmMcpKey[]
  removalNotices      TbPjMemberRemovalNotice[]
  projectMembers      TbPjProjectMember[]
  settingsHistory     TbPjSettingsHistory[]
  supportSessions     TbSysAdminSupportSession[]
  adminAudits         TbSysAdminAudit[]

  @@map("tb_cm_member")
}

/// 시스템 관리자의 고객 프로젝트 지원 세션 — 읽기 전용 접근 허용.
/// 30분 자동 만료. 쓰기 API 는 이 세션이 있어도 차단됨.
model TbSysAdminSupportSession {
  sess_id       String     @id @default(uuid()) @db.VarChar(36)
  admin_mber_id String     @db.VarChar(36)
  prjct_id      String     @db.VarChar(36)
  memo          String?
  expires_dt    DateTime
  ended_dt      DateTime?
  creat_dt      DateTime   @default(now())
  admin         TbCmMember @relation(fields: [admin_mber_id], references: [mber_id])

  @@index([admin_mber_id, prjct_id, expires_dt, ended_dt], map: "idx_sys_support_sess_active")
  @@map("tb_sys_admin_support_session")
}

/// 시스템 관리자 행동 감사 로그 — 책임추적성.
/// 지원 세션 개설·전역 리소스 변경·사용자 상태 변경 등을 모두 기록.
model TbSysAdminAudit {
  audit_id      String     @id @default(uuid()) @db.VarChar(36)
  admin_mber_id String     @db.VarChar(36)
  action_type   String     @db.VarChar(40)
  target_type   String?    @db.VarChar(40)
  target_id     String?    @db.VarChar(36)
  memo          String?
  ip_addr       String?    @db.VarChar(45)
  user_agent    String?    @db.VarChar(255)
  creat_dt      DateTime   @default(now())
  admin         TbCmMember @relation(fields: [admin_mber_id], references: [mber_id])

  @@index([admin_mber_id, creat_dt(sort: Desc)], map: "idx_sys_audit_admin")
  @@index([target_type, target_id], map: "idx_sys_audit_target")
  @@map("tb_sys_admin_audit")
}

model TbCmEmailVerification {
  vrfctn_id         String     @id @default(uuid())
  mber_id           String
  email_addr        String
  vrfctn_token_val  String     @unique
  vrfctn_ty_code    String     @default("REGISTER")
  vrfctn_sttus_code String     @default("PENDING")
  expiry_dt         DateTime
  vrfctn_dt         DateTime?
  creat_dt          DateTime   @default(now())
  member            TbCmMember @relation(fields: [mber_id], references: [mber_id])

  @@map("tb_cm_email_verification")
}

model TbCmRefreshToken {
  token_id       String     @id @default(uuid())
  mber_id        String
  token_hash_val String     @unique
  auto_login_yn  String     @default("N")
  expiry_dt      DateTime
  creat_dt       DateTime   @default(now())
  revoked_dt     DateTime?
  sesn_id        String?
  member         TbCmMember @relation(fields: [mber_id], references: [mber_id])

  @@map("tb_cm_refresh_token")
}

model TbCmLoginAttempt {
  attempt_id      String     @id @default(uuid())
  mber_id         String
  attempt_ip_addr String?
  succes_yn       String     @default("N")
  fail_rsn_cn     String?
  creat_dt        DateTime   @default(now())
  member          TbCmMember @relation(fields: [mber_id], references: [mber_id])

  @@map("tb_cm_login_attempt")
}

model TbCmAccountLock {
  lock_id                String     @id @default(uuid())
  mber_id                String
  lock_rsn_cn            String?
  fail_cnt               Int        @default(0)
  lock_expiry_dt         DateTime?
  unlock_token_val       String?    @unique
  unlock_token_expiry_dt DateTime?
  lock_sttus_code        String     @default("LOCKED")
  creat_dt               DateTime   @default(now())
  unlocked_dt            DateTime?
  member                 TbCmMember @relation(fields: [mber_id], references: [mber_id])

  @@map("tb_cm_account_lock")
}

model TbCmMemberSession {
  sesn_id        String     @id @default(uuid())
  mber_id        String
  device_info_cn String?
  ip_addr        String?
  creat_dt       DateTime   @default(now())
  last_acces_dt  DateTime?
  invald_dt      DateTime?
  member         TbCmMember @relation(fields: [mber_id], references: [mber_id])

  @@map("tb_cm_member_session")
}

model TbCmPasswordResetToken {
  reset_token_id   String     @id @default(uuid())
  mber_id          String
  token_val        String     @unique
  token_sttus_code String     @default("PENDING")
  expiry_dt        DateTime
  use_dt           DateTime?
  creat_dt         DateTime   @default(now())
  member           TbCmMember @relation(fields: [mber_id], references: [mber_id])

  @@map("tb_cm_password_reset_token")
}

model TbCmSocialAccount {
  social_acnt_id    String     @id @default(uuid())
  mber_id           String
  provdr_code       String
  provdr_user_id    String
  provdr_email_addr String?
  creat_dt          DateTime   @default(now())
  member            TbCmMember @relation(fields: [mber_id], references: [mber_id])

  @@unique([provdr_code, provdr_user_id])
  @@map("tb_cm_social_account")
}

model TbPjProject {
  prjct_id      String    @id @default(uuid())
  prjct_nm      String
  // 프로젝트 약어/이니셜 — docx 표지·머리말·파일명, 목록·GNB 부제 등에 사용.
  // 신규 생성/수정 시 API 가 ^[A-Za-z0-9]{2,10}$ 로 검증한다.
  // 기존 데이터 호환을 위해 DB 는 nullable 유지 — UI/문서 출력은 null 일 때
  // prjct_nm 으로 fallback.
  prjct_abrv    String?   @db.VarChar(10)
  // 프로젝트 정식 명칭 (Full Name) — 현재는 단순 정보 보관용.
  // 출력·검증·역할 없음. 향후 표지·머리말 등에 활용 검토.
  prjct_full_nm String?   @db.VarChar(100)
  prjct_dc      String?
  client_nm     String?
  bgng_de       DateTime?
  end_de        DateTime?

  // ── 단계별 일정 (2026-07-16 도입) ────────────────────────────────────
  // 별도 테이블 없이 프로젝트 테이블에 4단계 × 시작/종료 8컬럼으로 관리.
  // bgng_de/end_de(프로젝트 전체 기간)와 별개로, 단계별 진행 현황 표시에 사용.
  anls_bgng_de DateTime?
  anls_end_de  DateTime?
  dsgn_bgng_de DateTime?
  dsgn_end_de  DateTime?
  dev_bgng_de  DateTime?
  dev_end_de   DateTime?
  test_bgng_de DateTime?
  test_end_de  DateTime?

  creat_mber_id String?
  creat_dt      DateTime  @default(now())
  mdfcn_dt      DateTime?

  // ── Soft delete (2026-05-06 도입) ───────────────────────────────────────
  // OWNER 가 DELETE 를 호출하면 즉시 삭제하지 않고 다음 4개 컬럼이 세팅된다.
  //   - del_yn        : 'Y' = 삭제 예정, 'N' = 사용 중
  //   - del_dt        : 삭제 요청 시각
  //   - del_mber_id   : 삭제를 요청한 OWNER (감사 추적)
  //   - hard_del_dt   : 실제 hard delete 가 수행될 예정 시각
  //                     (= del_dt + 보관기간; 기본 14일, TbSysConfigTemplate 으로 조정)
  // hard_del_dt 가 지난 행은 별도 배치(project-hard-delete)가 일괄 정리한다.
  // 보관 기간 동안 OWNER 는 복구(restore) 가능, SUPER_ADMIN 은 항상 조회 가능.
  del_yn           String                    @default("N") @db.Char(1)
  del_dt           DateTime?
  del_mber_id      String?
  hard_del_dt      DateTime?
  planStudios      TbDsPlanStudio[]
  apiKeys          TbPjProjectApiKey[]
  invitations      TbPjProjectInvitation[]
  members          TbPjProjectMember[]
  settings         TbPjProjectSettings?
  settingsHistory  TbPjSettingsHistory[]
  standardInfos    TbCmStandardInfo[]
  // 2026-05-06 P1 — 핵심 도메인 6개 CASCADE
  unitWorks        TbDsUnitWork[]
  screens          TbDsScreen[]
  areas            TbDsArea[]
  functions        TbDsFunction[]
  tasks            TbRqTask[]
  requirements     TbRqRequirement[]
  // 2026-05-06 P2 — 부가 도메인 15개 CASCADE
  projectConfigs   TbPjProjectConfig[]
  removalNotices   TbPjMemberRemovalNotice[]
  designChanges    TbDsDesignChange[]
  documentReleases TbDsDocumentRelease[]
  dbTables         TbDsDbTable[]
  dbTableRevisions TbDsDbTableRevision[]
  progresses       TbCmProgress[]
  aiTasks          TbAiTask[]
  syncRuns         TbSpSyncRun[]
  attachFiles      TbCmAttachFile[]
  reviewRequests   tb_ds_review_request[]
  asisQuestions    tb_ds_asis_question[]
  codeGroups       TbCmCodeGroup[]
  codes            TbCmCode[]
  memos            TbDsMemo[]
  stdGuides        TbSgStdGuide[]
  // 2026-05-10 — QA 도메인 (테스트 명세서·케이스·회차·결과·결함·증적)
  testSpecs        TbQaTestSpec[]
  testCases        TbQaTestCase[]
  testRounds       TbQaTestRound[]
  testResults      TbQaTestResult[]
  defects          TbQaDefect[]
  evidences        TbQaEvidence[]
  // 2026-05-11 — 공통 점검 마스터 (프로젝트 전용 항목)
  checkMasters     TbQaCheckMaster[]
  // 2026-07-20 — 업무일지 / 주간보고
  workLogs         TbWrWorkLog[]
  weeklyReports    TbWrWeeklyReport[]
  // 2026-07-22 — 협조 및 이슈사항 (리더 리포트 인쇄용)
  issues           TbWrIssue[]
  // 2026-07-21 — 마일스톤 (설정 > 일정 탭)
  milestones       TbPjMilestone[]
  // 2026-07-22 — 공휴일 (설정 > 일정 탭) — WBS/업무일지 근무일 계산의 참조 데이터
  holidays         TbPjHoliday[]

  // 배치(project-hard-delete) 가 매일 스캔하는 인덱스
  // (del_yn='Y' AND hard_del_dt <= now()) 조건을 빠르게 추리기 위함
  @@index([del_yn, hard_del_dt], map: "tb_pj_project_soft_del_idx")
  @@map("tb_pj_project")
}

model TbPjProjectSettings {
  seting_id           String      @id @default(uuid())
  prjct_id            String      @unique
  ai_call_mthd_code   String      @default("DIRECT")
  plan_code           String      @default("FREE")
  // ── 출력 문서(.docx 등) 양식 기본값 ──────────────────────────────────────
  // copyright_holder    : 표지 / 바닥글의 저작권 문구 (예: "Copyright ⓒ (주)바른아이오")
  // doc_version_default : 출력 시 표지·변경이력 표의 기본 문서 버전 (예: "v1.0")
  // approver_nm         : 출력 시 표지/변경이력 표의 "승인자" 기본값 (보통 프로젝트 PM)
  //                       멤버 select 가 아닌 자유 텍스트 — 외부 PM(고객사 측) 도 가능하게.
  //                       추후 산출물별 발행이력(TbDsDocumentRelease) 도입 시
  //                       발행 모달의 "승인자" 입력란 기본값으로도 활용 예정.
  // 모두 nullable — 미설정 시 출력 핸들러에서 코드 fallback 사용
  copyright_holder    String?
  doc_version_default String?
  approver_nm         String?
  // ── 문서 메타/번호 체계 (2026-06 추가) ────────────────────────────────────
  // system_nm        : 표지 "시스템명" (미설정 시 프로젝트명 fallback)
  // system_code      : 문서번호 {SYS} 치환값 (미설정 시 약어 prjct_abrv fallback. 예: GDBS)
  // doc_no_template  : 문서번호 생성 템플릿 (미설정 시 코드 기본값 "{SYS}_{DOC}_{SEQ:3}")
  //                    치환 변수 {SYS}=시스템코드 {DOC}=산출물 문서코드 {SEQ:n}=일련번호(n자리) {YYYY}=연도
  // artifact_meta_json: 산출물별 단계/활동/작업/문서코드 오버라이드 (Phase 2 UI 용. 없으면 카탈로그 기본값)
  //                    형태: { "TASK_MATRIX": { "phase":"분석","activity":"...","work":"...","docCode":"A301" }, ... }
  system_nm           String?
  system_code         String?
  doc_no_template     String?
  artifact_meta_json  Json?
  creat_dt            DateTime    @default(now())
  mdfcn_dt            DateTime    @default(now())
  project             TbPjProject @relation(fields: [prjct_id], references: [prjct_id])

  @@map("tb_pj_project_settings")
}

model TbPjProjectInvitation {
  invt_id         String      @id @default(uuid())
  prjct_id        String
  email_addr      String
  role_code       String      @default("MEMBER") // OWNER/ADMIN/MEMBER/VIEWER
  job_title_code  String      @default("ETC") // PM/PL/DBA/DEV/DESIGNER/QA/ETC
  invt_token_val  String      @unique
  invtr_mber_id   String?
  invt_sttus_code String      @default("PENDING")
  invt_dt         DateTime    @default(now())
  expiry_dt       DateTime
  accept_dt       DateTime?
  cancel_dt       DateTime?
  // 프로젝트 삭제 시 자동 정리 (2026-05-06 핫픽스 — 누락된 CASCADE 보강)
  // 이전에는 RESTRICT 였기 때문에, 초대 이력이 한 건이라도 있으면 프로젝트
  // DELETE 가 FK 위반으로 실패했음.
  project         TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_pj_project_invitation_prjct_fk")

  @@map("tb_pj_project_invitation")
}

model TbPjProjectMember {
  prjct_mber_id   String      @id @default(uuid())
  prjct_id        String
  mber_id         String
  role_code       String      @default("MEMBER") // OWNER/ADMIN/MEMBER/VIEWER (보안·접근 제어)
  job_title_code  String      @default("ETC") // PM/PL/DBA/DEV/DESIGNER/QA/ETC (직무·개인화)
  join_dt         DateTime    @default(now())
  last_acces_dt   DateTime?
  mber_sttus_code String      @default("ACTIVE")
  sttus_chg_dt    DateTime?
  member          TbCmMember  @relation(fields: [mber_id], references: [mber_id])
  project         TbPjProject @relation(fields: [prjct_id], references: [prjct_id])

  @@unique([prjct_id, mber_id])
  @@map("tb_pj_project_member")
}

// ── 시스템 기본 환경설정 템플릿 — 프로젝트 생성 시 복사 원본 ─────────────
// TbPjProjectConfig 의 "원본" 역할. 운영자가 이 테이블만 관리해 두면
// 이후 신규 프로젝트에는 복사본이 자동 생성된다.
// 주의: prjct_id=NULL 런타임 병합 방식이 아닌 "실제 복사" 패턴 — 각
//       프로젝트의 설정이 서로 완전 독립적으로 진화해야 하기 때문.
model TbSysConfigTemplate {
  sys_tmpl_id    String    @id @default(uuid())
  config_group   String    @default("GENERAL")
  config_key     String    @unique(map: "tb_sys_config_template_key_uk")
  config_label   String    @default("")
  config_dc      String?
  value_type     String    @default("TEXT")
  default_value  String    @default("")
  select_options Json?
  sort_ordr      Int       @default(0)
  use_yn         String    @default("Y")
  creat_dt       DateTime  @default(now())
  mdfcn_dt       DateTime?

  @@index([use_yn, config_group, sort_ordr], map: "tb_sys_config_template_grp_idx")
  @@map("tb_sys_config_template")
}

// ── 프로젝트 환경설정 — key-value 방식 설정 관리 ────────────────────────────
model TbPjProjectConfig {
  config_id      String    @id @default(uuid())
  prjct_id       String
  config_group   String    @default("GENERAL")
  config_key     String
  config_value   String    @default("")
  config_label   String    @default("")
  config_dc      String?
  value_type     String    @default("TEXT")
  default_value  String    @default("")
  select_options Json?
  sort_ordr      Int       @default(0)
  creat_dt       DateTime  @default(now())
  mdfcn_dt       DateTime?

  // 프로젝트 삭제 시 자동 정리 (2026-05-06 P2 보강)
  project TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_pj_project_config_prjct_fk")

  @@unique([prjct_id, config_key], map: "tb_pj_project_config_uk")
  @@index([prjct_id, config_group], map: "tb_pj_project_config_grp_idx")
  @@map("tb_pj_project_config")
}

model TbPjProjectApiKey {
  api_key_id    String      @id @default(uuid())
  prjct_id      String
  provdr_nm     String
  encpt_key_val String
  mask_key_val  String
  creat_dt      DateTime    @default(now())
  mdfcn_dt      DateTime?
  // 프로젝트 삭제 시 자동 정리 (2026-05-06 핫픽스 — 누락된 CASCADE 보강)
  project       TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_pj_project_api_key_prjct_fk")

  @@map("tb_pj_project_api_key")
}

model TbPjSettingsHistory {
  hist_id     String      @id @default(uuid())
  prjct_id    String
  chg_mber_id String
  chg_item_nm String
  bfr_val_cn  String?
  aftr_val_cn String?
  chg_dt      DateTime    @default(now())
  member      TbCmMember  @relation(fields: [chg_mber_id], references: [mber_id])
  // 프로젝트 삭제 시 자동 정리 (2026-05-06 핫픽스 — 누락된 CASCADE 보강)
  // 본 테이블은 프로젝트 PUT 마다 행이 누적되므로, 변경이 한 번이라도
  // 있었던 모든 프로젝트는 이전 코드로 삭제 자체가 불가능했음.
  project     TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_pj_settings_history_prjct_fk")

  @@map("tb_pj_settings_history")
}

model TbPjMemberRemovalNotice {
  notice_id String      @id @default(uuid())
  mber_id   String
  prjct_id  String
  prjct_nm  String
  cnfrm_yn  String      @default("N")
  cnfrm_dt  DateTime?
  creat_dt  DateTime    @default(now())
  member    TbCmMember  @relation(fields: [mber_id], references: [mber_id])
  // 프로젝트 삭제 시 자동 정리 (2026-05-06 P2 보강)
  project   TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_pj_member_removal_notice_prjct_fk")

  @@map("tb_pj_member_removal_notice")
}

// ── 프로젝트 마일스톤 — 오픈일/이행일 등 핵심 일정 (2026-07-21 도입) ──────────
// 단계 범위(TbPjProject.anls_bgng_de 등)는 "기간"을 관리하지만, 마일스톤은
// "단일 시점" 이벤트를 이름 붙여 자유롭게 추가/삭제하는 용도 — 개수 제한 없음.
// 설정 > 일정 탭에서 관리. 완료 여부는 별도 컬럼 없이 오늘 날짜와 비교해 화면에서 판단.
model TbPjMilestone {
  milestone_id  String    @id @default(uuid())
  prjct_id      String
  milestone_nm  String
  milestone_de  DateTime  @db.Date
  // HTML(RichEditor/TipTap) — 착수보고회 장소/공지 등 팀원 공지용 본문. 이미지 붙여넣기 지원.
  cn            String?
  creat_mber_id String
  creat_dt      DateTime  @default(now())
  mdfr_mber_id  String?
  mdfcn_dt      DateTime?

  // 프로젝트 삭제 시 자동 정리
  project TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_pj_milestone_prjct_fk")

  // 설정 화면 목록 — 날짜 오름차순 정렬 조회
  @@index([prjct_id, milestone_de], map: "tb_pj_milestone_prjct_de_idx")
  @@map("tb_pj_milestone")
}

// ── 프로젝트 공휴일 — WBS/업무일지 근무일 계산의 참조 데이터 (2026-07-22 도입) ──
// 설날·추석처럼 음력 공휴일은 매년 날짜가 달라 코드에 고정 저장이 불가능하므로,
// 표준 목록(krHolidays.ts)을 프로젝트별로 "일괄 등록"해 실제 데이터로 굳혀 둔다.
// 수정 기능은 없음 — 잘못 등록한 날짜는 삭제 후 다시 등록(또는 수동 추가)한다.
model TbPjHoliday {
  holiday_id    String   @id @default(uuid())
  prjct_id      String
  holiday_nm    String
  holiday_de    DateTime @db.Date
  // LEGAL(표준 공휴일 일괄 등록) / CUSTOM(사용자가 직접 추가) — 목록 화면 배지 구분용
  holiday_se_cd String   @default("CUSTOM")
  creat_mber_id String
  creat_dt      DateTime @default(now())

  project TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_pj_holiday_prjct_fk")

  // 같은 날짜 중복 등록 방지 — 일괄 등록을 여러 번 눌러도 중복 생성되지 않음
  @@unique([prjct_id, holiday_de], map: "tb_pj_holiday_prjct_de_uq")
  @@map("tb_pj_holiday")
}

model TbDsDesignChange {
  chg_id        String   @id @default(uuid())
  prjct_id      String
  ref_tbl_nm    String
  ref_id        String
  chg_rsn_cn    String?
  snapshot_data Json
  ai_req_yn     String   @default("N")
  ai_task_id    String?
  chg_mber_id   String?
  chg_dt        DateTime @default(now())
  chg_type_code String   @default("UPDATE")

  // 프로젝트 삭제 시 자동 정리 (2026-05-06 P2 보강)
  project   TbPjProject    @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_ds_design_change_prjct_fk")
  syncItems TbSpSyncItem[]

  // 대시보드 "최근 변경" + "팀 활동(7일)" 카드용 인덱스.
  // (prjct_id, chg_dt DESC) 로 프로젝트별 최신순 페이지네이션·범위 스캔 모두 효율화.
  @@index([prjct_id, chg_dt(sort: Desc)], map: "idx_ds_design_change_prjct_dt")
  @@map("tb_ds_design_change")
}

// ─── 산출물 발행 이력 ───────────────────────────────────────────────────────
//
// 역할:
//   요구사항·단위업무·화면 등 모든 산출물 문서(.docx)의 "공식 발행" 기록.
//   사용자가 [발행] 버튼을 눌러 의식적으로 등록하는 단위 — 일반 데이터 수정 이력
//   (TbRqRequirementHistory, TbDsDesignChange) 과는 의미가 다른 별개 라이프사이클이다.
//
// TbDsDesignChange 와 분리한 이유:
//   - DesignChange = 데이터 변경 자동/수동 추적 (자주 발생, 스냅샷 Json)
//   - DocumentRelease = 산출물 발행 이벤트 (드물게 발생, 사용자가 정한 공식 버전 라벨 + 승인자)
//   - 라이프사이클·트리거·필수 컬럼(승인자) 모두 다름. 같은 테이블에 섞으면 쿼리·의미 모두 혼란.
//
// snapshot_data:
//   발행 시점의 RequirementExportInput 객체를 JSON 으로 박제.
//   이후 데이터(요구사항 본문/담당자/발주처명 등)가 바뀌어도 발행본은 그대로 복원 가능.
//   → "v1.0 다운로드" = 그 시점 그대로의 docx (시점 일관성 보장).
//
// doc_kind:
//   "REQUIREMENT" | "UNIT_WORK" | "SCREEN" | "AREA" | "FUNCTION" ... 등 산출물 종류.
//   현재는 REQUIREMENT 만 사용. 다른 도메인 출력 추가 시 같은 모델 재활용.
//
// 멤버 FK 미설정 (release_mber_id):
//   기존 도메인들과 동일한 패턴 — 발행자 멤버가 퇴장해도 이력 보존.
model TbDsDocumentRelease {
  release_id      String   @id @default(uuid())
  prjct_id        String
  doc_kind        String // "REQUIREMENT" | "UNIT_WORK" | "SCREEN" | ...
  ref_id          String // 산출물 도메인 행 ID (req_id, unit_work_id 등)
  vrsn_no         String // 사용자가 입력한 공식 버전 라벨 ("v1.0", "v1.1", "1.0.0" 등)
  change_cn       String? // 짧은 변경 사유 (한두 줄)
  author_nm       String? // 작성자 이름 (스냅샷 — 멤버명 박제)
  approver_nm     String? // 승인자 이름 (스냅샷)
  release_mber_id String? // 발행 버튼을 누른 멤버 ID (감사용 — 표시엔 미사용)
  snapshot_data   Json // 발행 시점의 양식 입력 객체 (이전 버전 다운로드 시 그대로 복원)
  released_dt     DateTime @default(now())

  // 프로젝트 삭제 시 자동 정리 (2026-05-06 P2 보강)
  project TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_ds_document_release_prjct_fk")

  // Word 출력 시 "이 산출물의 발행 이력 전체" 조회가 자주 발생 → 복합 인덱스
  @@index([prjct_id, doc_kind, ref_id], map: "tb_ds_doc_release_target_idx")
  @@map("tb_ds_document_release")
}

model TbDsUnitWork {
  unit_work_id         String           @id @default(uuid())
  prjct_id             String
  req_id               String
  unit_work_display_id String
  unit_work_nm         String           @default("")
  unit_work_dc         String?
  asign_mber_id        String?
  // 계획 설계 일정/공수 — PM이 잡는 상위 마일스톤. 하위 화면·기능의 실제 진행과는
  // 무관하게 관리되는 목표치(계획)이고, 실적(진행률)은 화면/기능 롤업으로 별도 계산한다.
  // (2026-07-28 리네임: bgng_de/end_de → plan_dsgn_*, progrs_rt 컬럼 제거 — 아래 참고)
  plan_dsgn_bgng_de    String?
  plan_dsgn_end_de     String?
  plan_dsgn_efrt_val   String?
  // 단위업무 설계서 작성 상태 — BEFORE(작성전) / DOING(작성중) / DONE(작성완료)
  dsgn_doc_sttus_code  String           @default("BEFORE")
  sort_ordr            Int              @default(0)
  creat_mber_id        String? // 생성자 회원 ID — FK 미설정(퇴장 멤버 기록 보존)
  creat_dt             DateTime         @default(now())
  mdfcn_mber_id        String? // 최종 수정자 회원 ID — 생성자 보정시간 판정 및 감사 추적
  mdfcn_dt             DateTime?
  coment_cn            String?
  screens              TbDsScreen[]
  // 2026-05-10 — 테스트 명세서 매핑 (단위테스트는 1행 / 통합테스트는 N행)
  testSpecLinks        TbQaTestSpecUw[]
  syncRuns             TbSpSyncRun[]
  requirement          TbRqRequirement  @relation(fields: [req_id], references: [req_id])
  // 프로젝트 삭제 시 자동 정리 (2026-05-06 보강)
  project              TbPjProject      @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_ds_unit_work_prjct_fk")

  @@index([prjct_id], map: "tb_ds_unit_work_prjct_idx")
  // 대시보드 "내 마감 임박" + "정체된 일" 카드 — (prjct_id, asign_mber_id) 동등 조건이 자주 옴.
  @@index([prjct_id, asign_mber_id], map: "idx_ds_unit_work_prjct_asignee")
  @@map("tb_ds_unit_work")
}

model TbDsScreen {
  scrn_id             String               @id @default(uuid())
  prjct_id            String
  unit_work_id        String?
  scrn_display_id     String
  scrn_nm             String               @default("")
  scrn_dc             String?
  scrn_ty_code        String               @default("LIST")
  url_path            String?
  asign_mber_id       String? // 담당자 회원 ID — FK 미설정(퇴장 멤버 기록 보존)
  sort_ordr           Int                  @default(0)
  creat_mber_id       String? // 생성자 회원 ID — FK 미설정(퇴장 멤버 기록 보존)
  creat_dt            DateTime             @default(now())
  mdfcn_mber_id       String? // 최종 수정자 회원 ID — 생성자 보정시간 판정 및 감사 추적
  mdfcn_dt            DateTime?
  ctgry_l_nm          String?
  ctgry_m_nm          String?
  ctgry_s_nm          String?
  dsply_code          String?
  layer_data_dc       String?
  coment_cn           String?
  // 실질 구현 일정 — 담당 개발자가 직접 커밋하는 실제 배정 일정.
  // (단위업무의 plan_dsgn_* 는 PM의 상위 계획치. 설계는 화면 여러 개를 한 사람이 이어서
  // 하는 경우가 많고 화면이 많으면 개별 일정 입력이 부담이라, 설계 일정/공수는 화면에
  // 두지 않고 단위업무의 plan_dsgn_*로만 관리 — 2026-07-28 2차 개편, 최초엔 화면에 있었음)
  // 구현 일정은 원래 기능(TbDsFunction)에 있었으나, 개발자가 실제로 보고 움직이는 마감
  // 기준은 화면 단위라 이쪽으로 이동함(2026-07-28).
  actl_impl_bgng_de   String?
  actl_impl_end_de    String?
  // 화면정의서 작성 상태 — BEFORE(작성전) / DOING(작성중) / DONE(작성완료)
  dsgn_doc_sttus_code String               @default("BEFORE")
  areas               TbDsArea[]
  unitWork            TbDsUnitWork?        @relation(fields: [unit_work_id], references: [unit_work_id])
  // 테스트 명세서 매핑 — 단위 테스트가 이 화면을 대상으로 작성되었음을 의미
  testSpecLinks       TbQaTestSpecScreen[]
  // 프로젝트 삭제 시 자동 정리 (2026-05-06 보강)
  project             TbPjProject          @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_ds_screen_prjct_fk")

  @@index([prjct_id], map: "tb_ds_screen_prjct_idx")
  @@map("tb_ds_screen")
}

model TbDsArea {
  area_id             String         @id @default(uuid())
  prjct_id            String
  scrn_id             String?
  area_display_id     String
  area_nm             String         @default("")
  area_dc             String?
  // 영역 유형 — "무엇이 담기는가" (데이터 성격)
  // FILTER(조회 조건) / LIST(데이터 목록) / FORM(데이터 양식) / DETAIL(상세 정보) / GENERAL(일반 콘텐츠)
  area_ty_code        String         @default("LIST")
  // 영역 표시 형태 — "어떻게 배치/작동하는가" (시각 방식)
  // STATIC(고정) / POPOVER(팝오버) / MODAL(모달) / DRAWER(드로어) / TABS(탭 전환) / ACCORDION(아코디언)
  // 종속 팝업도 별도 화면이 아닌 영역의 표시 형태 변형으로 표현.
  display_form_code   String         @default("STATIC")
  sort_ordr           Int            @default(0)
  creat_mber_id       String? // 생성자 회원 ID — FK 미설정(퇴장 멤버 기록 보존)
  creat_dt            DateTime       @default(now())
  mdfcn_mber_id       String? // 최종 수정자 회원 ID — 생성자 보정시간 판정 및 감사 추적
  mdfcn_dt            DateTime?
  excaldw_data        Json?
  layer_data_dc       String?
  coment_cn           String?
  // 영역 설계(와이어프레임) 작성 상태 — BEFORE(작성전) / DOING(작성중) / DONE(작성완료)
  dsgn_doc_sttus_code String         @default("BEFORE")
  screen              TbDsScreen?    @relation(fields: [scrn_id], references: [scrn_id])
  functions           TbDsFunction[]
  // 프로젝트 삭제 시 자동 정리 (2026-05-06 보강)
  project             TbPjProject    @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_ds_area_prjct_fk")

  @@index([prjct_id], map: "tb_ds_area_prjct_idx")
  @@map("tb_ds_area")
}

model TbDsFunction {
  func_id             String      @id @default(uuid())
  prjct_id            String
  area_id             String?
  func_display_id     String
  func_nm             String      @default("")
  func_dc             String?
  priort_code         String      @default("MEDIUM")
  sort_ordr           Int         @default(0)
  creat_mber_id       String? // 생성자 회원 ID — FK 미설정(퇴장 멤버 기록 보존)
  creat_dt            DateTime    @default(now())
  mdfcn_mber_id       String? // 최종 수정자 회원 ID — 생성자 보정시간 판정 및 감사 추적
  mdfcn_dt            DateTime?
  asign_mber_id       String?
  cmplx_code          String      @default("MEDIUM")
  // 구현 공수 (2026-07-28 리네임: efrt_val → impl_efrt_val — 화면의 actl_dsgn_efrt_val과 대칭)
  impl_efrt_val       String?
  func_ty_code        String      @default("OTHER")
  // 기능정의서 작성 상태 — BEFORE(작성전) / DOING(작성중) / DONE(작성완료)
  // 구현 일정(시작/종료일)은 화면(TbDsScreen.actl_impl_*)으로 이동함 — 기능 개별 마감일은
  // 관리하지 않고, 화면 마감일 안에서 개인이 알아서 진행(구현/테스트 진척률=%만 tb_cm_progress에 기록)
  dsgn_doc_sttus_code String      @default("BEFORE")
  coment_cn           String?
  area                TbDsArea?   @relation(fields: [area_id], references: [area_id])
  // 프로젝트 삭제 시 자동 정리 (2026-05-06 보강)
  project             TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_ds_function_prjct_fk")

  @@index([prjct_id], map: "tb_ds_function_prjct_idx")
  @@map("tb_ds_function")
}

model TbDsDbTable {
  tbl_id        String              @id @default(uuid())
  prjct_id      String
  tbl_physcl_nm String
  tbl_lgcl_nm   String?
  tbl_dc        String?
  asign_mber_id String? // 담당자 회원 ID — FK 미설정(퇴장 멤버 기록 보존)
  // 2차 사업 등 스키마가 계속 바뀌는 상황에서 "이게 새로 생긴 건지 원래 있던 건지 곧 없앨 건지"를
  // 사람이 직접 표시해두는 용도. NEW(신규)/EXISTING(기존)/DEPRECATED(데디케이트) — 자동 분류 없음, 전부 수동 지정.
  // 기본값은 신규 등록 폼에서 사람이 못 고를 때의 중립값 — 명시적으로 고르기 전까지는 "기존"으로 취급.
  tbl_sttus_code String             @default("EXISTING")
  creat_dt      DateTime            @default(now())
  mdfcn_mber_id String?
  mdfcn_dt      DateTime?           @db.Timestamp(3)
  columns       TbDsDbTableColumn[]
  // 프로젝트 삭제 시 자동 정리 (2026-05-06 P2 보강)
  project       TbPjProject         @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_ds_db_table_prjct_fk")

  @@index([prjct_id], map: "tb_ds_db_table_prjct_idx")
  @@map("tb_ds_db_table")
}

model TbDsDbTableColumn {
  col_id        String      @id @default(uuid())
  tbl_id        String
  col_physcl_nm String
  col_lgcl_nm   String?
  data_ty_nm    String?
  col_dc        String?
  ref_grp_code  String?     @db.VarChar(100) // 참조 공통코드 그룹코드 (tb_cm_code_group.grp_code)
  sort_ordr     Int         @default(0)
  creat_dt      DateTime    @default(now())
  mdfcn_mber_id String?
  mdfcn_dt      DateTime?   @db.Timestamp(3)
  // 부모 테이블 삭제 시 컬럼도 함께 정리 (2026-05-06 보강 — 프로젝트 cascade 호환)
  table         TbDsDbTable @relation(fields: [tbl_id], references: [tbl_id], onDelete: Cascade)

  @@map("tb_ds_db_table_column")
}

/// DB 테이블/컬럼 변경 이력 (감사 기록용)
///   - 한 번의 저장 요청 = 한 revision (여러 컬럼 변경을 묶음)
///   - snapshot_data: { table:{before,after}, columns:{added[],modified[],removed[]} }
///   - chg_summary: "컬럼 3개 추가, 1개 수정" 같은 자동 생성 요약
///   - AI/사람 구분 없음 (시킨 사람의 chg_mber_id 에 기록)
model TbDsDbTableRevision {
  rev_id        String   @id @default(uuid())
  prjct_id      String
  tbl_id        String
  rev_no        Int // 해당 테이블 내 순번 (1부터)
  chg_type_code String // CREATE | UPDATE | DELETE
  chg_summary   String? // 자동 생성 요약
  snapshot_data Json // diff 스냅샷
  chg_mber_id   String?
  chg_dt        DateTime @default(now())

  // 프로젝트 삭제 시 자동 정리 (2026-05-06 P2 보강)
  project TbPjProject @relation(fields: [prjct_id], references: [prjct_id], onDelete: Cascade, map: "tb_ds_db_table_revision_prjct_fk")

  @@index([tbl_id, chg_dt(sort: Desc)], map: "idx_db_tbl_rev_tbl")
  @@index([prjct_id, chg_dt(sort: Desc)], map: "idx_db_tbl_rev_prjct")
  @@map("tb_ds_db_table_revision")
}

