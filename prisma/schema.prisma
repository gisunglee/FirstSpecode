model TbWrIssue {
  issue_id      String      @id @default(uuid())
  prjct_id      String
  // CUSTOMER_REQ(고객요청) | OUR_REQ(당사요청) | ISSUE(이슈)
  // "요청자" 하나로는 누가 누구에게 요청한 건지 방향이 안 보인다는 피드백으로 분리 —
  // 방향이 있는 협조요청 2종 + 방향이 없는 일반 이슈로 구분한다 (2026-07-22 확장).
  category_code String      @default("ISSUE") @db.VarChar(20)
