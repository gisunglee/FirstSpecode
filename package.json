{
  "name": "firstspecode",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && next build",
    "start": "next start",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "test:db-push": "dotenv -e .env.local -- node scripts/test-prisma-db-push.mjs",
    "db:migrate:drop-baseline": "dotenv -e .env.local -- prisma db execute --schema prisma/schema.prisma --file ddl/20260512-drop-baseline.sql",
    "db:migrate:spec-sync": "dotenv -e .env.local -- prisma db execute --schema prisma/schema.prisma --file prisma/sql/2026-08-17_create_spec_sync_v2.sql",
    "db:migrate:extend-memo": "dotenv -e .env.local -- prisma db execute --schema prisma/schema.prisma --file prisma/sql/2026-08-19_extend_tb_ds_memo.sql",
    "db:migrate:spec-creator-permissions": "dotenv -e .env.local -- node scripts/run-spec-creator-permissions-migration.mjs",
    "test:ddl": "npx tsx scripts/test-ddl-parser.ts && npx tsx scripts/test-ddl-parser-2.ts",
    "test:codes": "npx tsx scripts/test-codes.ts",
    "test:standard-guides": "npx tsx --test scripts/standard-guide-usage.test.ts",
    "test:text-limits": "npx tsx scripts/test-text-limits.ts",
    "test:spec-content-policy": "tsc -p tsconfig.spec-content-policy-tests.json && node --test tmp/spec-content-policy-tests/scripts/spec-content-policy.test.js",
    "test:spec-sync": "tsc -p tsconfig.spec-sync-tests.json && node --test tmp/spec-sync-tests/scripts/spec-sync-contract.test.js scripts/spec-sync-migration.test.mjs && node .claude/commands/validate_specode_sync.mjs --repo . --input scripts/fixtures/spec-sync-valid-result.json",
    "test:auth-security": "tsc -p tsconfig.auth-security-tests.json && node --test tmp/auth-security-tests/scripts/auth-security-policy.test.js",
    "test:work-log": "npx tsx --test scripts/work-log-week-narrative.test.ts",
    "test:auth-security:db": "dotenv -e .env.local -- npx tsx scripts/refresh-token-rotation-db-smoke.ts",
    "test:auth-cookie:db": "dotenv -e .env.local -- npx tsx scripts/auth-cookie-db-smoke.ts",
    "test:spec-sync:db": "dotenv -e .env.local -- node scripts/check-spec-sync-db.mjs --expect-v2 && dotenv -e .env.local -- node scripts/spec-sync-db-smoke.mjs",
    "test:asis-question:db": "dotenv -e .env.local -- node scripts/asis-question-db-smoke.mjs",
    "scan:text-lengths": "dotenv -e .env.local -- npx tsx scripts/scan-text-lengths.ts",
    "postinstall": "node -e \"const fs=require('fs'),f='node_modules/@excalidraw/excalidraw/dist/dev/index.css';if(fs.existsSync(f)){const c=fs.readFileSync(f,'utf8');fs.writeFileSync(f,c.replace(/\\/\\*#\\s*sourceMappingURL=[^*]*\\*\\//g,''));}\" && prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "private": true,
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@fortune-sheet/react": "^1.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@svar-ui/react-gantt": "^2.7.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.95.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-color": "^3.20.5",
    "@tiptap/extension-image": "^3.20.5",
    "@tiptap/extension-placeholder": "^3.20.5",
    "@tiptap/extension-table": "^3.20.5",
    "@tiptap/extension-table-cell": "^3.20.5",
    "@tiptap/extension-table-header": "^3.20.5",
    "@tiptap/extension-table-row": "^3.20.5",
    "@tiptap/extension-text-style": "^3.20.5",
    "@tiptap/pm": "^3.20.5",
    "@tiptap/react": "^3.20.5",
    "@tiptap/starter-kit": "^3.20.5",
    "@types/diff": "^7.0.2",
    "bcryptjs": "^3.0.3",
    "diff": "^8.0.4",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "image-size": "^2.0.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "marked": "^17.0.5",
    "mcp-handler": "^1.1.0",
    "mermaid": "^11.14.0",
    "next": "^16.2.1",
    "nodemailer": "^8.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "dotenv-cli": "^11.0.0",
    "postcss": "^8.5.8",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}
