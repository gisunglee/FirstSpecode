# Supabase 연결 설정
# Supabase 대시보드 → Settings → Database → Connection string (URI 방식) 복사
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Direct URL (마이그레이션용 — connection pooler 우회)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=specode-files
SUPABASE_STORAGE_PREFIX=dev

# 사용 방법:
#   1. 이 파일을 .env.local 로 복사
#   2. 실제 값으로 교체
#   3. .env.local 은 .gitignore 에 포함되어 있으므로 커밋되지 않음

# ─── 결제 (2026-09-20, .claude/biz/B.결제정책.md §3 2단계) ─────────────────
# PG 구현 선택: mock(기본, 앱 안 "PG 창"으로 흉내 — 운영에서도 내부 사용자만 쓰는 동안 사용) | toss(가맹 심사 후)
PAYMENT_GATEWAY=
# Mock PG 로 구독을 시작할 수 있는 이메일 도메인 (운영, 쉼표 구분). 비우면 bareun.io. SUPER_ADMIN 은 항상 허용
BILLING_MOCK_ALLOWED_EMAIL_DOMAINS=mock
# Mock 웹훅 수신 시크릿 (X-Mock-Signature 헤더). 비워 두면 웹훅 경로가 닫힌다
MOCK_WEBHOOK_SECRET=
# 빌링키·API 키 암호화 키 (32자). 운영에서는 반드시 설정
API_KEY_SECRET=
# 일일 배치(/api/admin/batch/run/billing-daily 등) cron 호출용 시크릿 — 32자 이상
BATCH_CRON_SECRET=
