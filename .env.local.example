# Supabase 연결 설정
# Supabase 대시보드 → Settings → Database → Connection string (URI 방식) 복사
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase Direct URL (마이그레이션용 — connection pooler 우회)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# UW 전체 관련 소스를 역설계하는 DEEP_SYNC는 별도 Shadow 검증 통과 후에만 true로 변경
# CHECK Shadow 결과를 사람이 승인한 환경에서만 true
SPEC_SYNC_ENABLED="false"
# DEEP_SYNC Shadow 결과까지 별도로 승인한 환경에서만 true
SPEC_SYNC_DEEP_ENABLED="false"

# 사용 방법:
#   1. 이 파일을 .env.local 로 복사
#   2. 실제 값으로 교체
#   3. .env.local 은 .gitignore 에 포함되어 있으므로 커밋되지 않음
